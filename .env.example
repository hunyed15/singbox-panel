# 必填:主密钥,用于 AES-256-GCM 加密凭据(openssl rand -hex 32)
APP_SECRET=replace-with-openssl-rand-hex-32
# 需要 Node >= 24(内置 node:sqlite,零原生依赖;node 20 配旧原生模块会段错误)
PANEL_LISTEN=0.0.0.0:8081
PANEL_DB=./data/panel.db
ADMIN_USER=admin
ADMIN_PASS=
JWT_SECRET=replace-with-another-random-string
SINGBOX_BIN=/usr/local/bin/sing-box
SINGBOX_CONFIG=/etc/sing-box/config.json
SINGBOX_UNIT=sing-box
# sing-box release 下载基地址;GitHub 不稳时可切 gh-proxy 镜像,如:
# SINGBOX_DOWNLOAD_BASE=https://ghproxy.com/https://github.com/SagerNet/sing-box/releases/download
CHECK_TIMEOUT_MS=15000
DEPLOY_TIMEOUT_MS=60000